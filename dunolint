(lang dunolint 1.0)

;; Everything is instrumented

(rule
 (enforce
  (dune
   (instrumentation
    (backend bisect_ppx)))))

;; Test lib naming

(rule
 (cond
  ((path
    (glob test/**))
   (enforce
    (dune
     (library
      (and
       (not
        (has_field public_name))
       (package
        (equals doc-experiment-docusaurus-tests)))))))))
